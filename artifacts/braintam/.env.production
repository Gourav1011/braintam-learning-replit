# Production (VPS — frontend and backend on same origin: braintam.com)
# Empty string = relative URLs (/api/...) — nginx proxies /api to the Node.js process.
# Do NOT set this to an absolute URL unless the backend moves to a separate host.
VITE_API_URL=

# Live Clerk publishable key (encodes FAPI: clerk.braintam.com)
# NOTE: braintam.com (no www) must be the canonical domain — nginx must redirect
# www.braintam.com → braintam.com, otherwise publishableKeyFromHost derives
# clerk.www.braintam.com from the hostname which is NXDOMAIN.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuYnJhaW50YW0uY29tJA

# Clerk proxy — routes all Clerk FAPI calls through your domain.
VITE_CLERK_PROXY_URL=https://braintam.com/api/__clerk
